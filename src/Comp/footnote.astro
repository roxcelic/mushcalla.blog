---
<div id="footnote">
    <p id="footnoteText">
        loading
    </p>
    <script is:inline>
        let getSongData = async (hi) => {
            try {
                let response = await fetch(`https://api.mushcalla.blog`);
                let data = await response.json();
                return data;
            } catch (e) {
                return {};
            }
        };

        let displayData = async () => {
            let songInfo = await getSongData();
            let textDisplay = document.getElementById("footnoteText");

            if (Object.keys(songInfo).length != 0) {
                console.log(songInfo);
                textDisplay.innerText = `Roxy is listening to ${songInfo.name} by ${songInfo.artist["#text"]}`;
                textDisplay.addEventListener("click", () => {
                    if (document.body.style.backgroundImage == "") document.body.style.backgroundImage = `url('${songInfo.image[3]["#text"]}')`;
                    else document.body.style.backgroundImage = "";
                });
            } else {
                textDisplay.innerText = `website made by Roxy`;
            }
        };

        displayData();
    </script>
</div>